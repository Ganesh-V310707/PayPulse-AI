# Copy this file to server/.env. NEVER share, upload or commit server/.env.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/paypulse_ai
# Use true only if your server is *behind a trusted reverse proxy*, not for arbitrary public traffic.
TRUST_PROXY=false

# Commerce: Google Shopping data via a properly licensed third-party data service.
# Required for REAL product listings and real prices. See https://serpapi.com/
SERPAPI_KEY=aefbfa1d18cb055fa5ec03ed44fee31dadcba8acea58a40fd6a572e0719e7a77
# Primary country: IN (INR), US (USD), GB (GBP)
SHOPPING_COUNTRY=IN
# Optional eBay Browse API (only US/GB in this package; requires eBay production API access)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# For food barcode lookup, specify your OWN real app contact per Open Food Facts policy
PRODUCT_USER_AGENT=PayPulseAI/2.1 (contact: YOUR_CONTACT_EMAIL_OR_URL)

# Gemini API: needed for image recognition and natural-language explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sandbox-only test payment provider; no real-money commerce checkout is implemented.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Required to enter the Payment Intelligence admin area. Generate a random 32+ character string.
ADMIN_API_KEY=44ccc6a1bf5b5e03d94b8de94065a96c60a162445b13e26653e9a59b7f0bb246
